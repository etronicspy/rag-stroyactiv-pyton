# ===================================
# RAG Construction Materials API Configuration Example
# ===================================
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: Do NOT commit files with real secrets!
# Use only env.example for templates

# ===================================
# ENVIRONMENT SETTINGS (Required)
# ===================================
ENVIRONMENT=development
PROJECT_NAME=RAG Construction Materials API
VERSION=0.1.0-dev
API_V1_STR=/api/v1

# ===================================
# CORS CONFIGURATION (Required)
# ===================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===================================
# VECTOR DATABASE CONFIGURATION (All supported, fill only those in use per environment)
# ===================================
DATABASE_TYPE=qdrant_local  # qdrant_cloud, qdrant_local, weaviate, pinecone

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev-qdrant-key
QDRANT_COLLECTION_NAME=materials_dev
QDRANT_VECTOR_SIZE=1536
QDRANT_TIMEOUT=30

# --- Weaviate (Optional) ---
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=dev-weaviate-key

# --- Pinecone (Optional) ---
PINECONE_API_KEY=dev-pinecone-key
PINECONE_ENVIRONMENT=us-west1-gcp-dev

# ===================================
# RELATIONAL DATABASE CONFIGURATION (PostgreSQL)
# ===================================
POSTGRESQL_URL=postgresql+asyncpg://devuser:devpass@localhost:5432/dev_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=dev_rag
POSTGRESQL_POOL_SIZE=5
POSTGRESQL_MAX_OVERFLOW=10

# Feature Flags
DISABLE_POSTGRESQL_CONNECTION=false
QDRANT_ONLY_MODE=false
DISABLE_QDRANT_CONNECTION=false
DISABLE_REDIS_CONNECTION=false

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_TIMEOUT=10

# ===================================
# SSH TUNNEL SERVICE CONFIGURATION (Optional, for remote DB access)
# ===================================
ENABLE_SSH_TUNNEL=false
SSH_TUNNEL_LOCAL_PORT=5435
SSH_TUNNEL_REMOTE_HOST=127.0.0.1
SSH_TUNNEL_REMOTE_USER=devuser
SSH_TUNNEL_REMOTE_PORT=5432
SSH_TUNNEL_KEY_PATH=~/.ssh/dev_postgres_key
SSH_TUNNEL_KEY_PASSPHRASE=
SSH_TUNNEL_TIMEOUT=30
SSH_TUNNEL_RETRY_ATTEMPTS=1
SSH_TUNNEL_RETRY_DELAY=2
SSH_TUNNEL_HEARTBEAT_INTERVAL=30
SSH_TUNNEL_AUTO_RESTART=false
SSH_TUNNEL_COMPRESSION=false
SSH_TUNNEL_KEEP_ALIVE=30
SSH_TUNNEL_STRICT_HOST_KEY_CHECKING=false

# ===================================
# AI PROVIDER CONFIGURATION (All supported, fill only those in use per environment)
# ===================================
AI_PROVIDER=openai  # openai, azure_openai, huggingface, ollama

# --- OpenAI ---
OPENAI_API_KEY=sk-dev-openai-key
OPENAI_MODEL=text-embedding-3-small
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT=20

# --- Azure OpenAI (Optional) ---
AZURE_OPENAI_API_KEY=dev-azure-key
AZURE_OPENAI_ENDPOINT=http://localhost:8000
AZURE_OPENAI_MODEL=text-embedding-ada-002

# --- HuggingFace (Optional) ---
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_DEVICE=cpu

# --- Ollama (Optional) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===================================
# PERFORMANCE SETTINGS
# ===================================
MAX_UPLOAD_SIZE=10485760  # 10MB
BATCH_SIZE=10
MAX_CONCURRENT_UPLOADS=2

# ===================================
# MIDDLEWARE SETTINGS
# ===================================
MAX_REQUEST_SIZE_MB=10
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_RATE_LIMITING=false
RATE_LIMIT_RPM=30
RATE_LIMIT_RPH=500
RATE_LIMIT_BURST=5

# ===================================
# LOGGING CONFIGURATION
# ===================================
LOG_LEVEL=DEBUG
ENABLE_STRUCTURED_LOGGING=false
LOG_FILE=logs/app_dev.log
LOG_COLORS=true
LOG_THIRD_PARTY_LEVEL=DEBUG
ENABLE_REQUEST_LOGGING=true
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
LOG_REQUEST_HEADERS=true
LOG_MASK_SENSITIVE_HEADERS=false
LOG_MAX_BODY_SIZE=16384
LOG_CORRELATION_ID=true
LOG_CORRELATION_ID_HEADER=X-Correlation-ID
LOG_DATABASE_OPERATIONS=true
LOG_SQL_QUERIES=true
LOG_SQL_PARAMETERS=true
LOG_VECTOR_OPERATIONS=true
LOG_CACHE_OPERATIONS=true
LOG_PERFORMANCE_METRICS=true
LOG_TIMING_DETAILS=true
LOG_SLOW_OPERATION_THRESHOLD_MS=2000
LOG_SECURITY_EVENTS=true
LOG_BLOCKED_REQUESTS=true
LOG_SECURITY_INCIDENTS=true
LOG_TIMESTAMP_FORMAT=ISO8601
LOG_SOURCE_INFO=true
LOG_STACK_TRACE=true
LOG_FILE_ROTATION=false
LOG_FILE_MAX_SIZE_MB=5
LOG_FILE_BACKUP_COUNT=2
LOG_ASYNC_LOGGING=false
LOG_BUFFER_SIZE=50
LOG_FLUSH_INTERVAL=2
LOG_MIDDLEWARE_LEVEL=DEBUG
LOG_SERVICES_LEVEL=DEBUG
LOG_API_LEVEL=DEBUG
LOG_DATABASE_LEVEL=DEBUG
LOG_EXCLUDE_PATHS=["/docs","/openapi.json","/favicon.ico","/static","/health"]
LOG_EXCLUDE_HEADERS=["user-agent","accept-encoding","accept-language"]

# ===================================
# FALLBACK STRATEGIES
# ===================================
ENABLE_FALLBACK_DATABASES=true
DB_MAX_RETRIES=1
DB_RETRY_INTERVAL=2

# ===================================
# CACHE SETTINGS
# ===================================
ENABLE_RESPONSE_CACHE=true
CACHE_TTL=60
CACHE_MAX_SIZE=100

# ===================================
# PARSER CONFIGURATION (Advanced, for parser microservice)
# ===================================
PARSER_OPENAI_API_KEY=sk-dev-openai-key  # fallback: OPENAI_API_KEY
PARSER_MODELS_OPENAI_MODEL=gpt-4o-mini
PARSER_MODELS_EMBEDDING_MODEL=text-embedding-3-small
PARSER_MODELS_EMBEDDING_DIMENSIONS=1536
PARSER_MODELS_TEMPERATURE=0.2
PARSER_MODELS_MAX_TOKENS=500
PARSER_PERFORMANCE_BATCH_SIZE=2
PARSER_PERFORMANCE_MAX_BATCH_SIZE=5
PARSER_PERFORMANCE_TIMEOUT=10
PARSER_PERFORMANCE_AI_REQUEST_TIMEOUT=15
PARSER_PERFORMANCE_BATCH_TIMEOUT=60
PARSER_PERFORMANCE_RETRY_ATTEMPTS=1
PARSER_PERFORMANCE_MAX_CONCURRENT_REQUESTS=2
PARSER_VALIDATION_CONFIDENCE_THRESHOLD=0.7
PARSER_VALIDATION_ENABLE_VALIDATION=true
PARSER_VALIDATION_ENABLE_STRICT_VALIDATION=false
PARSER_VALIDATION_REQUIRE_UNITS=true
PARSER_VALIDATION_REQUIRE_COEFFICIENTS=false
PARSER_VALIDATION_VALIDATE_COLORS=true
PARSER_CACHE_ENABLE_CACHING=true
PARSER_CACHE_CACHE_TTL=600
PARSER_CACHE_EMBEDDING_CACHE_TTL=3600
PARSER_CACHE_ENABLE_PERSISTENT_CACHE=false
PARSER_CACHE_CACHE_SIZE_LIMIT=1000
PARSER_DEBUG_DEBUG_MODE=true
PARSER_DEBUG_LOG_AI_REQUESTS=true
PARSER_DEBUG_LOG_PARSE_RESULTS=true
PARSER_DEBUG_SAVE_DEBUG_FILES=true
PARSER_DEBUG_DEBUG_FILE_PATH=debug/parser
PARSER_INTEGRATION_MODE=true
PARSER_USE_MAIN_PROJECT_CONFIG=true
PARSER_ENVIRONMENT=development

# ===================================
# TESTING SETTINGS (Dev/Test only)
# ===================================
USE_MOCK_DATA=true
TEST_DATA_PATH=tests/data

# ===================================
# CONSTANTS (Advanced, rarely changed, fallback to code defaults)
# ===================================
VECTOR_SIZE_OPENAI_SMALL=1536
VECTOR_SIZE_OPENAI_LARGE=3072
VECTOR_SIZE_OPENAI_ADA_002=1536
VECTOR_SIZE_HUGGINGFACE_MINI=384
VECTOR_SIZE_HUGGINGFACE_BASE=768
COLLECTION_NAME_CONSTRUCTION_COLORS=construction_colors_dev
COLLECTION_NAME_CONSTRUCTION_UNITS=construction_units_dev
COLLECTION_NAME_CONSTRUCTION_CATEGORIES=construction_categories_dev
DEFAULT_TIMEOUT_DATABASE=10
DEFAULT_TIMEOUT_AI_CLIENT=10
DEFAULT_TIMEOUT_CONNECTION_POOL=10
DEFAULT_TIMEOUT_REDIS=5
DEFAULT_TIMEOUT_SSH_TUNNEL=10
DEFAULT_PORT_POSTGRESQL=5432
DEFAULT_PORT_REDIS=6379
DEFAULT_PORT_SSH_TUNNEL_LOCAL=5435
FILE_SIZE_MAX_UPLOAD_BYTES=10485760
FILE_SIZE_MAX_UPLOAD_MB=10
FILE_SIZE_MAX_CONFIG_FILE_BYTES=10485760
FILE_SIZE_MAX_CONFIG_FILE_MB=10
DATABASE_NAME_QDRANT_COLLECTION=materials_dev
DATABASE_NAME_WEAVIATE_CLASS=MaterialDev
DATABASE_NAME_PINECONE_INDEX=materials_dev
DATABASE_NAME_POSTGRESQL_DB=dev_rag
DATABASE_NAME_REDIS_KEY_PREFIX=rag_dev:
MODEL_NAME_OPENAI_EMBEDDING=text-embedding-3-small
MODEL_NAME_HUGGINGFACE_DEFAULT=sentence-transformers/all-MiniLM-L6-v2
MODEL_NAME_AZURE_API_VERSION=2023-05-15
CONNECTION_POOL_POSTGRESQL_POOL_SIZE=5
CONNECTION_POOL_POSTGRESQL_MAX_OVERFLOW=10
CONNECTION_POOL_REDIS_MAX_CONNECTIONS=10
CONNECTION_POOL_BATCH_SIZE=2
CONNECTION_POOL_MAX_CONCURRENT_UPLOADS=2
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_REQUESTS_PER_HOUR=500
RATE_LIMIT_BURST_LIMIT=5
SSH_DEFAULT_REMOTE_HOST=127.0.0.1
SSH_DEFAULT_REMOTE_USER=devuser
SSH_DEFAULT_KEY_PATH=~/.ssh/dev_postgres_key
SSH_DEFAULT_RETRY_ATTEMPTS=1
SSH_DEFAULT_RETRY_DELAY=2
SSH_DEFAULT_KEEP_ALIVE=30
CACHE_REDIS_DEFAULT_TTL=600
PARSER_CONSTANT_DEFAULT_OPENAI_MODEL=gpt-4o-mini
PARSER_CONSTANT_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
PARSER_CONSTANT_DEFAULT_EMBEDDING_DIMENSIONS=1536
PARSER_CONSTANT_DEFAULT_BATCH_SIZE=2
PARSER_CONSTANT_MAX_BATCH_SIZE=5
PARSER_CONSTANT_MIN_BATCH_SIZE=1
PARSER_CONSTANT_DEFAULT_CONFIDENCE_THRESHOLD=0.7
PARSER_CONSTANT_MIN_CONFIDENCE_THRESHOLD=0.1
PARSER_CONSTANT_MAX_CONFIDENCE_THRESHOLD=1.0
PARSER_CONSTANT_DEFAULT_PARSER_TIMEOUT=10
PARSER_CONSTANT_DEFAULT_AI_REQUEST_TIMEOUT=15
PARSER_CONSTANT_DEFAULT_BATCH_TIMEOUT=60
PARSER_CONSTANT_DEFAULT_RETRY_ATTEMPTS=1
PARSER_CONSTANT_MAX_RETRY_ATTEMPTS=3
PARSER_CONSTANT_DEFAULT_CACHE_TTL=600
PARSER_CONSTANT_DEFAULT_EMBEDDING_CACHE_TTL=3600