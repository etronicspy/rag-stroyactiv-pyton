# ===================================
# RAG Construction Materials API Production Configuration
# ===================================
# Copy this file to .env.local for production deployment and fill in your actual values
# IMPORTANT: NEVER commit this file with real secrets or production credentials!
# Use only for deployment and CI/CD pipelines

# ===================================
# ENVIRONMENT SETTINGS (Required)
# ===================================
ENVIRONMENT=production
PROJECT_NAME=RAG Construction Materials API
VERSION=1.0.0
API_V1_STR=/api/v1

# ===================================
# CORS CONFIGURATION (Required)
# ===================================
# Set to your production frontend domains only
BACKEND_CORS_ORIGINS=["https://your-frontend.com","https://admin.your-frontend.com"]

# ===================================
# VECTOR DATABASE CONFIGURATION (All supported, fill only those in use per environment)
# ===================================
DATABASE_TYPE=qdrant_cloud  # qdrant_cloud, qdrant_local, weaviate, pinecone

# --- Qdrant ---
QDRANT_URL=https://your-qdrant-prod-cluster.qdrant.io:6333
QDRANT_API_KEY=your_real_qdrant_api_key
QDRANT_COLLECTION_NAME=materials
QDRANT_VECTOR_SIZE=1536
QDRANT_TIMEOUT=30

# --- Weaviate (Optional) ---
WEAVIATE_URL=https://your-prod-weaviate-cluster.weaviate.network
WEAVIATE_API_KEY=your_real_weaviate_api_key

# --- Pinecone (Optional) ---
PINECONE_API_KEY=your_real_pinecone_api_key
PINECONE_ENVIRONMENT=us-west1-gcp-prod

# ===================================
# RELATIONAL DATABASE CONFIGURATION (PostgreSQL)
# ===================================
POSTGRESQL_URL=postgresql+asyncpg://youruser:yourpass@your-prod-db-host:5432/your_prod_db
POSTGRES_HOST=your-prod-db-host
POSTGRES_PORT=5432
POSTGRES_USER=youruser
POSTGRES_PASSWORD=yourpass
POSTGRES_DB=your_prod_db
POSTGRESQL_POOL_SIZE=20
POSTGRESQL_MAX_OVERFLOW=40

# Feature Flags
DISABLE_POSTGRESQL_CONNECTION=false
QDRANT_ONLY_MODE=false
DISABLE_QDRANT_CONNECTION=false
DISABLE_REDIS_CONNECTION=false

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_URL=redis://your-prod-redis-host:6379
REDIS_PASSWORD=your_real_redis_password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_TIMEOUT=10

# ===================================
# SSH TUNNEL SERVICE CONFIGURATION (Optional, for remote DB access)
# ===================================
ENABLE_SSH_TUNNEL=true
SSH_TUNNEL_LOCAL_PORT=5435
SSH_TUNNEL_REMOTE_HOST=your-prod-db-host
SSH_TUNNEL_REMOTE_USER=youruser
SSH_TUNNEL_REMOTE_PORT=5432
SSH_TUNNEL_KEY_PATH=/etc/ssl/your_prod_postgres_key
SSH_TUNNEL_KEY_PASSPHRASE=your_real_ssh_key_passphrase
SSH_TUNNEL_TIMEOUT=30
SSH_TUNNEL_RETRY_ATTEMPTS=5
SSH_TUNNEL_RETRY_DELAY=10
SSH_TUNNEL_HEARTBEAT_INTERVAL=60
SSH_TUNNEL_AUTO_RESTART=true
SSH_TUNNEL_COMPRESSION=true
SSH_TUNNEL_KEEP_ALIVE=60
SSH_TUNNEL_STRICT_HOST_KEY_CHECKING=true

# ===================================
# AI PROVIDER CONFIGURATION (All supported, fill only those in use per environment)
# ===================================
AI_PROVIDER=openai  # openai, azure_openai, huggingface, ollama

# --- OpenAI ---
OPENAI_API_KEY=your_real_openai_api_key
OPENAI_MODEL=text-embedding-3-small
OPENAI_MAX_RETRIES=5
OPENAI_TIMEOUT=30

# --- Azure OpenAI (Optional) ---
AZURE_OPENAI_API_KEY=your_real_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=text-embedding-ada-002

# --- HuggingFace (Optional) ---
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_DEVICE=cpu

# --- Ollama (Optional) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===================================
# PERFORMANCE SETTINGS
# ===================================
MAX_UPLOAD_SIZE=52428800  # 50MB
BATCH_SIZE=100
MAX_CONCURRENT_UPLOADS=10

# ===================================
# MIDDLEWARE SETTINGS
# ===================================
MAX_REQUEST_SIZE_MB=50
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000
RATE_LIMIT_BURST=10

# ===================================
# LOGGING CONFIGURATION
# ===================================
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
LOG_FILE=logs/app.log
LOG_COLORS=false
LOG_THIRD_PARTY_LEVEL=WARNING
ENABLE_REQUEST_LOGGING=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_REQUEST_HEADERS=true
LOG_MASK_SENSITIVE_HEADERS=true
LOG_MAX_BODY_SIZE=65536
LOG_CORRELATION_ID=true
LOG_CORRELATION_ID_HEADER=X-Correlation-ID
LOG_DATABASE_OPERATIONS=true
LOG_SQL_QUERIES=false
LOG_SQL_PARAMETERS=false
LOG_VECTOR_OPERATIONS=true
LOG_CACHE_OPERATIONS=true
LOG_PERFORMANCE_METRICS=true
LOG_TIMING_DETAILS=false
LOG_SLOW_OPERATION_THRESHOLD_MS=1000
LOG_SECURITY_EVENTS=true
LOG_BLOCKED_REQUESTS=true
LOG_SECURITY_INCIDENTS=true
LOG_TIMESTAMP_FORMAT=ISO8601
LOG_SOURCE_INFO=true
LOG_STACK_TRACE=false
LOG_FILE_ROTATION=true
LOG_FILE_MAX_SIZE_MB=50
LOG_FILE_BACKUP_COUNT=10
LOG_ASYNC_LOGGING=true
LOG_BUFFER_SIZE=1000
LOG_FLUSH_INTERVAL=5
LOG_MIDDLEWARE_LEVEL=INFO
LOG_SERVICES_LEVEL=INFO
LOG_API_LEVEL=INFO
LOG_DATABASE_LEVEL=INFO
LOG_EXCLUDE_PATHS=["/docs","/openapi.json","/favicon.ico","/static","/health"]
LOG_EXCLUDE_HEADERS=["user-agent","accept-encoding","accept-language"]

# ===================================
# FALLBACK STRATEGIES
# ===================================
ENABLE_FALLBACK_DATABASES=true
DB_MAX_RETRIES=5
DB_RETRY_INTERVAL=10

# ===================================
# CACHE SETTINGS
# ===================================
ENABLE_RESPONSE_CACHE=true
CACHE_TTL=600
CACHE_MAX_SIZE=10000

# ===================================
# PARSER CONFIGURATION (Advanced, for parser microservice)
# ===================================
PARSER_OPENAI_API_KEY=your_real_openai_api_key  # fallback: OPENAI_API_KEY
PARSER_MODELS_OPENAI_MODEL=gpt-4o-mini
PARSER_MODELS_EMBEDDING_MODEL=text-embedding-3-small
PARSER_MODELS_EMBEDDING_DIMENSIONS=1536
PARSER_MODELS_TEMPERATURE=0.1
PARSER_MODELS_MAX_TOKENS=1000
PARSER_PERFORMANCE_BATCH_SIZE=50
PARSER_PERFORMANCE_MAX_BATCH_SIZE=100
PARSER_PERFORMANCE_TIMEOUT=30
PARSER_PERFORMANCE_AI_REQUEST_TIMEOUT=45
PARSER_PERFORMANCE_BATCH_TIMEOUT=300
PARSER_PERFORMANCE_RETRY_ATTEMPTS=5
PARSER_PERFORMANCE_MAX_CONCURRENT_REQUESTS=10
PARSER_VALIDATION_CONFIDENCE_THRESHOLD=0.85
PARSER_VALIDATION_ENABLE_VALIDATION=true
PARSER_VALIDATION_ENABLE_STRICT_VALIDATION=true
PARSER_VALIDATION_REQUIRE_UNITS=true
PARSER_VALIDATION_REQUIRE_COEFFICIENTS=true
PARSER_VALIDATION_VALIDATE_COLORS=true
PARSER_CACHE_ENABLE_CACHING=true
PARSER_CACHE_CACHE_TTL=86400
PARSER_CACHE_EMBEDDING_CACHE_TTL=172800
PARSER_CACHE_ENABLE_PERSISTENT_CACHE=true
PARSER_CACHE_CACHE_SIZE_LIMIT=100000
PARSER_DEBUG_DEBUG_MODE=false
PARSER_DEBUG_LOG_AI_REQUESTS=false
PARSER_DEBUG_LOG_PARSE_RESULTS=false
PARSER_DEBUG_SAVE_DEBUG_FILES=false
PARSER_DEBUG_DEBUG_FILE_PATH=debug/parser
PARSER_INTEGRATION_MODE=false
PARSER_USE_MAIN_PROJECT_CONFIG=true
PARSER_ENVIRONMENT=production

# ===================================
# TESTING SETTINGS (Dev/Test only)
# ===================================
USE_MOCK_DATA=false
TEST_DATA_PATH=tests/data

# ===================================
# CONSTANTS (Advanced, rarely changed, fallback to code defaults)
# ===================================
VECTOR_SIZE_OPENAI_SMALL=1536
VECTOR_SIZE_OPENAI_LARGE=3072
VECTOR_SIZE_OPENAI_ADA_002=1536
VECTOR_SIZE_HUGGINGFACE_MINI=384
VECTOR_SIZE_HUGGINGFACE_BASE=768
COLLECTION_NAME_CONSTRUCTION_COLORS=construction_colors
COLLECTION_NAME_CONSTRUCTION_UNITS=construction_units
COLLECTION_NAME_CONSTRUCTION_CATEGORIES=construction_categories
DEFAULT_TIMEOUT_DATABASE=30
DEFAULT_TIMEOUT_AI_CLIENT=30
DEFAULT_TIMEOUT_CONNECTION_POOL=30
DEFAULT_TIMEOUT_REDIS=10
DEFAULT_TIMEOUT_SSH_TUNNEL=30
DEFAULT_PORT_POSTGRESQL=5432
DEFAULT_PORT_REDIS=6379
DEFAULT_PORT_SSH_TUNNEL_LOCAL=5435
FILE_SIZE_MAX_UPLOAD_BYTES=52428800
FILE_SIZE_MAX_UPLOAD_MB=50
FILE_SIZE_MAX_CONFIG_FILE_BYTES=104857600
FILE_SIZE_MAX_CONFIG_FILE_MB=100
DATABASE_NAME_QDRANT_COLLECTION=materials
DATABASE_NAME_WEAVIATE_CLASS=Material
DATABASE_NAME_PINECONE_INDEX=materials
DATABASE_NAME_POSTGRESQL_DB=your_prod_db
DATABASE_NAME_REDIS_KEY_PREFIX=rag:
MODEL_NAME_OPENAI_EMBEDDING=text-embedding-3-small
MODEL_NAME_HUGGINGFACE_DEFAULT=sentence-transformers/all-MiniLM-L6-v2
MODEL_NAME_AZURE_API_VERSION=2023-05-15
CONNECTION_POOL_POSTGRESQL_POOL_SIZE=20
CONNECTION_POOL_POSTGRESQL_MAX_OVERFLOW=40
CONNECTION_POOL_REDIS_MAX_CONNECTIONS=50
CONNECTION_POOL_BATCH_SIZE=50
CONNECTION_POOL_MAX_CONCURRENT_UPLOADS=10
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST_LIMIT=10
SSH_DEFAULT_REMOTE_HOST=your-prod-db-host
SSH_DEFAULT_REMOTE_USER=youruser
SSH_DEFAULT_KEY_PATH=/etc/ssl/your_prod_postgres_key
SSH_DEFAULT_RETRY_ATTEMPTS=5
SSH_DEFAULT_RETRY_DELAY=10
SSH_DEFAULT_KEEP_ALIVE=60
CACHE_REDIS_DEFAULT_TTL=86400
PARSER_CONSTANT_DEFAULT_OPENAI_MODEL=gpt-4o-mini
PARSER_CONSTANT_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
PARSER_CONSTANT_DEFAULT_EMBEDDING_DIMENSIONS=1536
PARSER_CONSTANT_DEFAULT_BATCH_SIZE=50
PARSER_CONSTANT_MAX_BATCH_SIZE=100
PARSER_CONSTANT_MIN_BATCH_SIZE=1
PARSER_CONSTANT_DEFAULT_CONFIDENCE_THRESHOLD=0.85
PARSER_CONSTANT_MIN_CONFIDENCE_THRESHOLD=0.1
PARSER_CONSTANT_MAX_CONFIDENCE_THRESHOLD=1.0
PARSER_CONSTANT_DEFAULT_PARSER_TIMEOUT=30
PARSER_CONSTANT_DEFAULT_AI_REQUEST_TIMEOUT=45
PARSER_CONSTANT_DEFAULT_BATCH_TIMEOUT=300
PARSER_CONSTANT_DEFAULT_RETRY_ATTEMPTS=5
PARSER_CONSTANT_MAX_RETRY_ATTEMPTS=10
PARSER_CONSTANT_DEFAULT_CACHE_TTL=86400
PARSER_CONSTANT_DEFAULT_EMBEDDING_CACHE_TTL=172800 